 "content_length": null,
 "bytes": 32071,
 "text": "\r\n<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\r\n<html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\">\r\n<head id=\"Head1\"><title>\r\n\r\n</title><meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge,chrome=1\" /><link rel=\"Stylesheet\" type=\"text/css\" href=\"Styles/font-awesome.min.css\" /><link rel=\"Stylesheet\" type=\"text/css\" href=\"Styles/bootstrap.min.css\" /><link rel=\"Stylesheet\" type=\"text/css\" href=\"Styles/bootstrap-datepicker.standalone.min.css\" /><link rel=\"Stylesheet\" type=\"text/css\" href=\"Styles/Site.css\" /><link rel=\"Stylesheet\" type=\"text/css\" href=\"Styles/jquery.ui.theme.css\" /><link rel=\"stylesheet\" type=\"text/css\" href=\"Styles/ui-grid.css\" /><link rel=\"stylesheet\" type=\"text/css\" href=\"Styles/select.css\" /><link rel=\"stylesheet\" type=\"text/css\" href=\"Styles/select2.css\" /><link rel=\"stylesheet\" type=\"text/css\" href=\"Styles/jquery-confirm.min.css\" /><link rel=\"stylesheet\" type=\"text/css\" href=\"Styles/bootstrap-multiselect.css\" />\r\n    <script type=\"text/javascript\" src=\"Scripts/jquery-3.7.1.js\"></script>\r\n    <script type=\"text/javascript\" src=\"Scripts/bootstrap.min.js\"></script>\r\n    <script type=\"text/javascript\" src=\"Scripts/angular.js\"></script>\r\n    <script type=\"text/javascript\" src=\"Scripts/angular-sanitize.js\"></script>\r\n    <script type=\"text/javascript\" src=\"Scripts/angular-touch.js\"></script>\r\n    <script type=\"text/javascript\" src=\"Scripts/angular-animate.js\"></script>\r\n    <script type=\"text/javascript\" src=\"Scripts/pdfmake.js\"></script>\r\n    <script type=\"text/javascript\" src=\"Scripts/vfs_fonts.js\"></script>\r\n    <script type=\"text/javascript\" src=\"Scripts/ui-grid.js\"></script>\r\n    <script type=\"text/javascript\" src=\"Scripts/select.js\"></script>\r\n    <script type=\"text/javascript\" src=\"Scripts/CommonMethod.js?version=1.0\"></script>\r\n    <script type=\"text/javascript\" src=\"Scripts/jsMessages.js\"></script>\r\n    <script type=\"text/javascript\" src=\"Scripts/jsConstants.js\"></script>\r\n    <script type=\"text/javascript\" src=\"Scripts/bootstrap-datepicker.js\"></script>\r\n    <script type=\"text/javascript\" src=\"Scripts/jquery-confirm.min.js\"></script>\r\n    <script type=\"text/javascript\" src=\"Scripts/bootstrap-multiselect.js\"></script>\r\n    <script type=\"text/javascript\">\r\n        function ShowProgress() {\r\n            setTimeout(function () {\r\n                $(\".loading\").show();\r\n            }, 200);\r\n        }\r\n        $(document).ready(function () {\r\n            $(\".loading\").hide();\r\n            resizeTextArea();\r\n            var IsLogin = getParameterByName('IsLogin');\r\n            if (IsLogin != undefined && IsLogin == \"true\")\r\n                $(\"#ModalLogin\").modal('show');\r\n        });\r\n        function XMLDownloadClick() {\r\n            //ShowProgress();\r\n            alert('d');\r\n            ShowProgressBar();\r\n            __doPostBack(\"ctl00$lbDownloadXml\", \"\"); // To postback \r\n        }\r\n\r\n        function closeLoader() {\r\n            if ($(\".loader\") != undefined && $(\".loader\").length > 0)\r\n                $(\".loader\").hide();\r\n            $(\".loading\").hide();\r\n        }\r\n\r\n        function ShowProgressBar() {\r\n            $(\".loading\").show();\r\n            myInterval = setInterval(function () {\r\n                getSessionValue();\r\n            }, 700);\r\n        }\r\n\r\n        function getSessionValue() {\r\n            $.ajax({\r\n                type: \"POST\",\r\n                url: \"Search.aspx/GetSessionData\",\r\n                data: \"{}\",\r\n                contentType: \"application/json; charset=utf-8\",\r\n                dataType: \"json\",\r\n                success: function (msg) {\r\n                    if (msg.d == '1') {\r\n                        $(\".loading\").hide();\r\n                        clearInterval(myInterval); //delete interval\r\n                        $.ajax({\r\n                            type: \"POST\",\r\n                            url: \"Search.aspx/SetSessionData\",\r\n                            data: \"{}\",\r\n                            contentType: \"application/json; charset=utf-8\",\r\n                            dataType: \"json\",\r\n                            success: function (msg) {\r\n                                // Do something with the session value that came back in the variable \"msg\"\r\n                            }\r\n                        });\r\n\r\n                    }\r\n                }\r\n            });\r\n        }\r\n\r\n        var DownloadRecordCount = '100';\r\n        var DownloadforXML = '1';\r\n        var DownloadforPDF = '1';\r\n        var DownloadforExcel = '0';\r\n        var DownloadforWord = '0';\r\n    </script>\r\n    \r\n</head>\r\n<body ng-app=\"app\">\r\n    <form method=\"post\" action=\"./\" id=\"frmMain\" class=\"form-horizontal\">\r\n<input type=\"hidden\" name=\"__VIEWSTATE\" id=\"__VIEWSTATE\" value=\"\" />\r\n\r\n<input type=\"hidden\" name=\"__VIEWSTATEGENERATOR\" id=\"__VIEWSTATEGENERATOR\" value=\"CA0B0334\" />\r\n<input type=\"hidden\" name=\"__EVENTVALIDATION\" id=\"__EVENTVALIDATION\" value=\"\" />\r\n    \r\n<script type=\"text/javascript\">\r\n    function closeLoginAlert() {\r\n        $(\"#divLoginAlert\").css('display', 'none');\r\n    }\r\n\r\n    function showLoginUpAlert(spnLoginMessage, strMessageType) {\r\n        AddCssClassforMessages(\"divLoginAlert\", strMessageType);\r\n        $(\"#spnLoginMessage\")[0].innerText = spnLoginMessage;\r\n        $(\"#divLoginAlert\").css('display', 'block');\r\n        $(\"#ModalLogin\").modal({ show: true });\r\n    }\r\n\r\n    function hideSignUp(that) {\r\n        if ($(\"#\" + that.id + \" input:checked\").val() == \"1\")\r\n            $(\".divFooterRight\").css('display', 'none');\r\n        else\r\n            $(\".divFooterRight\").css('display', 'inline');\r\n    }\r\n</script>\r\n<div id=\"ModalLogin\" class=\"modal fade\" role=\"dialog\">\r\n    <div class=\"modal-dialog\">\r\n        <!-- Modal Login-->\r\n        <div class=\"modal-content\">\r\n            <div class=\"modal-header\">\r\n                <button type=\"button\" class=\"close\" data-dismiss=\"modal\">\r\n                    &times;</button>\r\n                <span class=\"SectionHeadingW\">Login</span><br />\r\n                <span class=\"SectionHeadingTextW\">Please fill in your login information</span>\r\n            </div>\r\n            <div class=\"modal-body\">\r\n                <div class=\"col-md-12 col-sm-12\">\r\n                    \r\n                    <div id=\"divLoginAlert\" class=\"alert col-sm-12\" style=\"display: none\">\r\n                        <div class=\"col-md-11 col-sm-11 text-left\">\r\n                            <span id=\"spnLoginMessage\"></span>\r\n                            <br />\r\n                        </div>\r\n                        <div class=\"col-md-1 col-sm-1 text-right\">\r\n                            <span class=\"glyphicon glyphicon-remove\" onclick=\"javascript:closeLoginAlert();\">\r\n                            </span>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"col-md-12 col-sm-12 form-group\">\r\n                    </div>\r\n                    <div class=\"col-md-12 col-sm-12 form-group\">\r\n                        <input name=\"ctl00$ucLogin1$txtUserName\" type=\"text\" id=\"ucLogin1_txtUserName\" class=\"form-control\" placeholder=\"Username\" onkeypress=\"return spaceRemover(event);\" onblur=\"this.value=this.value.toString().trim()\" />\r\n                        \r\n                    </div>\r\n                    <div class=\"col-md-12 col-sm-12 form-group\">\r\n                        <input name=\"ctl00$ucLogin1$txtPassword\" type=\"password\" id=\"ucLogin1_txtPassword\" class=\"form-control\" placeholder=\"Password\" />\r\n                        \r\n                    </div>\r\n                    <div class=\"col-md-12 col-sm-12 form-group text-center\">\r\n                        <input type=\"submit\" name=\"ctl00$ucLogin1$btnLogin\" value=\"Login\" onclick=\"javascript:WebForm_DoPostBackWithOptions(new WebForm_PostBackOptions(&quot;ctl00$ucLogin1$btnLogin&quot;, &quot;&quot;, true, &quot;valLogin&quot;, &quot;&quot;, false, false))\" id=\"ucLogin1_btnLogin\" class=\"SubmitButtonG\" />\r\n                    </div>\r\n                    <div class=\"col-md-12 col-sm-12 form-group text-center divFooterRight\" style=\"color: #999999\">\r\n                        Don't have an account! <a style=\"color: #003366\" href=\"Register.aspx\">Sign up here</a>\r\n                        | <a style=\"color: #003366\" href=\"ForgotPassword.aspx\">Forgot password?</a>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div class=\"modal-footer\">\r\n            </div>\r\n        </div>\r\n    </div>\r\n</div>\r\n\r\n    \r\n<div class=\"sticky-side sticky-side-right visible-md visible-lg\" style=\"margin-top: -115px;\">\r\n    <a href=\"https://www.facebook.com/pages/SA-Medical-Research-Council/149479531731987\"\r\n        target=\"_blank\" class=\"social-icon social-icon-light social-icon-round social-facebook\"\r\n        title=\"\" data-toggle=\"tooltip\" data-placement=\"left\" data-original-title=\"Share on Facebook\">\r\n        <i class=\"fa fa-facebook\"></i><i class=\"fa fa-facebook\"></i></a><a href=\"https://twitter.com/MRCza\"\r\n            target=\"_blank\" class=\"social-icon social-icon-light social-icon-round social-twitter\"\r\n            title=\"\" data-toggle=\"tooltip\" data-placement=\"left\" data-original-title=\"Share on Twitter\">\r\n            <i class=\"fa fa-twitter\"></i><i class=\"fa fa-twitter\"></i></a><a href=\"https://www.linkedin.com/company/south-african-medical-research-council\"\r\n                target=\"_blank\" class=\"social-icon social-icon-light social-icon-round social-linkedin\"\r\n                title=\"\" data-toggle=\"tooltip\" data-placement=\"left\"><i class=\"fa fa-linkedin\"></i>\r\n                <i class=\"fa fa-linkedin\"></i></a>\r\n</div>\r\n\r\n    <nav class=\"navbar navbar-default\" role=\"navigation\">              \r\n            <div class=\"container-head\">      \r\n                <header class=\"headerBar portalWidth\">\r\n                    <div class=\"col-md-12 col-sm-12\" style=\"height :80px;padding-left:0px;padding-top:0px;\">\r\n                        <div class=\"col-md-7 col-sm-7\" style=\"padding:0px;\">\r\n                            <div class=\"col-md-1 col-sm-1\">\r\n                            </div>\r\n                            <div class=\"col-md-2 col-sm-2\" style =\"vertical-align:middle;\">\r\n                                <button type=\"button\" class=\"navbar-toggle collapsed\" data-toggle=\"collapse\" data-target=\"#cssmenu\">\r\n                                    <span class=\"sr-only\">Toggle navigation</span>\r\n                                    <span class=\"icon-bar\"></span>\r\n                                    <span class=\"icon-bar\"></span>\r\n                                    <span class=\"icon-bar\"></span>\r\n                                </button>\r\n                                <button type=\"button\" class=\"navbar-toggle navbar-right right pull-right collapsed navbar-link glyphicon glyphicon-user\" data-toggle=\"collapse\" data-target=\"#rtMenu\">\r\n                                </button>\r\n                                <a href=\"Default.aspx\"><img src=\"Images/PACTRlogo.png\" style =\"vertical-align:middle;line-height:80px\" alt=\"\"/></a>\r\n                            </div> \r\n                            <div class=\"col-md-9 col-sm-9\" style =\"vertical-align:middle; padding-left :50px; \">\r\n                                <div class=\"collapse navbar-collapse\" id=\"cssmenu\" style=\"min-width:600px \">     \r\n                                    <ul class=\"nav navbar-nav\"><li id=\"A0\" class=\" active\"><a href=\"Default.aspx\">Home</a></li><li class=\"\"><a href=\"#\" class=\"dropdown-toggle\" data-toggle=\"dropdown\">About us<b class=\"caret\"></b></a><ul class=\"dropdown-menu multi-level\"><li id=\"A5\" class=\"\"><a href=\"PACTRHistory.aspx\">History of PACTR</a></li><li id=\"A6\" class=\"\"><a href=\"Members.aspx\">Our team</a></li><li id=\"A13\" class=\"\"><a href=\"Default.aspx#Funder\">Funders</a></li><li id=\"A15\" class=\"\"><a href=\"PACTROutputs.aspx\">PACTR outputs</a></li></ul></li><li class=\"\"><a href=\"#\" class=\"dropdown-toggle\" data-toggle=\"dropdown\">Why register<b class=\"caret\"></b></a><ul class=\"dropdown-menu multi-level\"><li id=\"A7\" class=\"\"><a href=\"WhyRegister.aspx\">Why register</a></li><li id=\"A8\" class=\"\"><a href=\"Benefits.aspx\">Benefits of registering</a></li><li id=\"A9\" class=\"\"><a href=\"HowToRegister.aspx\">How to register</a></li><li id=\"A10\" class=\"\"><a href=\"Links.aspx\">Useful links</a></li><li id=\"A11\" class=\"\"><a href=\"TermsAndConditions.aspx\">Terms and conditions</a></li><li id=\"A12\" class=\"\"><a href=\"FAQ.aspx\">Frequently asked questions</a></li></ul></li><li id=\"A3\" class=\"\"><a href=\"GIS_Viewer.aspx\">Map</a></li><li id=\"A4\" class=\"\"><a href=\"Default.aspx#dvContact\">Contact us</a></li><li id=\"A14\" class=\"\"><a href=\"Search_v2.aspx\">Search</a></li></ul>\r\n                                    <input type=\"submit\" name=\"ctl00$lbDownloadXml\" value=\"\" id=\"lbDownloadXml\" class=\"SubmitButtonG\" style=\"display: none\" />\r\n                                </div>  \r\n                            </div>\r\n                        </div>\r\n                        <div class=\"col-md-1 col-sm-1 text-right\">\r\n                        </div>\r\n                        <div class=\"col-md-4 col-sm-4 text-right\">\r\n                            <div id=\"rtMenu\" class=\"collapse navbar-collapse\" style=\"padding:0px 15px;\">\r\n                                <div class=\"col-md-4 col-sm-4\" style=\"padding:0px 0px\">\r\n                                    <button type=\"button\" class=\"LoginButton\" data-toggle=\"modal\" data-target=\"#ModalLogin\"><img style=\"vertical-align:middle;padding-right :15px\" src=\"Images/Profile.png\"/>Login</button>                                    \r\n                                </div>\r\n                                <div class=\"col-md-4 col-sm-4\" style=\"padding:0px 0px\">\r\n                                    <a href=\"Register.aspx\" style=\"vertical-align:middle;line-height :90px\"><i class=\"glyphicon glyphicon-plus\" style=\"padding-right:15px;\"></i>Register user</a>\r\n                                </div>\r\n                                <div class=\"col-md-4 col-sm-4\" style=\"padding:0px 0px\">\r\n                                    <a href=\"#\" data-toggle=\"modal\" data-target=\"#ModalLogin\" style=\"vertical-align:middle;line-height :90px;border:1px solid #fff;padding:15px 15px\">New trial</a>\r\n                                </div>\r\n                            </div>           \r\n                        </div>                \r\n                    </div>\r\n                    <div class=\"col-md-12 col-sm-12\">\r\n                    </div>\r\n                </header>\r\n            </div>\r\n        </nav>\r\n    <div>\r\n        <div id=\"dvHeader\" class=\"col-md-12 headerBannerD portalWidth\" style=\"height:520px;background-image:url(images/Banner_Split.jpg);\">\r\n            <div id=\"dvHomeControls\" class=\"col-md-12 col-sm-12\" style=\"margin-top: 30px;\">\r\n                <div class=\"col-md-6 col-sm-6\">\r\n                </div>\r\n                <div class=\"col-md-6 col-sm-6\">\r\n                    <div class=\"col-md-offset-3 col-sm-offset-3\" style=\"height: 75px\">\r\n                        <div class=\"BannerButton\">\r\n                            <a href=\"Search.aspx\">Search trial</a></div>\r\n                    </div>\r\n                    <div class=\"col-md-offset-2 col-sm-offset-2\" style=\"height: 75px\">\r\n                        <div class=\"BannerButton\">\r\n                            <a href=\"#\" data-toggle=\"modal\" data-target=\"#ModalLogin\">Register a trial</a></div>\r\n                    </div>\r\n                    <div class=\"col-md-offset-1 col-sm-offset-1\" style=\"height: 75px\">\r\n                        <div class=\"BannerButton\">\r\n                            <a href=\"GIS_Viewer.aspx\">Map of African trials</a></div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        \r\n        <div class=\"portalWidth\" style=\"min-height: 700px\">\r\n            \r\n    \r\n<script type=\"text/javascript\">\r\n    $('a').click(function () {\r\n        if ($(this).attr('href') != undefined && $(this).attr('href').indexOf('#') > 0) {\r\n            $('html, body').animate({\r\n                scrollTop: $.attr(this, 'href').split('#')[1] != undefined ? $('#' + $.attr(this, 'href').split('#')[1] + '').offset().top : scrollTop\r\n            }, 2000);\r\n\r\n            return false;\r\n        }\r\n    });\r\n\r\n    function showAlert(spnMessage, strMessageType) {\r\n        if (strMessageType != 'warning') {\r\n            $(\"#txtName\").val('');\r\n            $(\"#txtEmail\").val('');\r\n            $(\"#ddlFeedbackType\").val(\"0\");\r\n            $(\"#txtFeedback\").val('');\r\n            $(\"#txtVerificationCode\").val('');\r\n        }\r\n        JQueryCustomMessage(spnMessage, 'Information');\r\n    }\r\n</script>\r\n<div id=\"divfocus\" style=\"vertical-align: top;\">\r\n</div>\r\n<div class=\"col-md-12 col-sm-12 page-heading\">\r\n    Welcome to PACTR\r\n</div>\r\n<div class=\"col-md-12 col-sm-12\">\r\n    <div class=\"about-details ContentSlab\">\r\n        <p>\r\n            The Pan African Clinical Trials Registry (PACTR) is a regional register of clinical\r\n            trials conducted in Africa. The registry is an African initiative serving the needs\r\n            of Africans. It provides an open-access platform where clinical trials can be registered\r\n            free of charge. The PACTR aims to increase clinical trial registration in Africa\r\n            by developing awareness of the need to register trials and supporting trialists\r\n            during registration.\r\n        </p>\r\n        <p>\r\n            In addition, PACTR provides a searchable, electronic database of planned trials\r\n            and trials currently in progress. Those wishing to search the database of trials,\r\n            can do so from the homepage, by clicking on the “search” link. There is no need\r\n            to register on the site if you simply want to search the database.</p>\r\n        <p>\r\n            The PACTR is unique in recognising that African trialists face additional challenges\r\n            in trial registration and seeks to provide feasible ways of overcoming these. For\r\n            example, a common problem for individuals living in sub-Saharan Africa is limited,\r\n            unreliable and costly internet access. With this in mind, the registry provides\r\n            alternative means of trial registration for registrants who do not have reliable\r\n            access to the internet. Trials may be registered manually by email, postal mail\r\n            or facsimile correspondence and trial registration is free.\r\n        </p>\r\n    </div>\r\n</div>\r\n\r\n<div class=\"col-md-12 col-sm-12 page-heading\">\r\n    Announcements\r\n</div>\r\n<div class=\"col-md-12 col-sm-12\">\r\n    <div class=\"Announcements ContentSlab\">\r\n        <p>\r\n            <a class=\"link\" href=\"https://events.teams.microsoft.com/event/b3e08648-1a62-493b-9e8e-aa97a1bdde03@f1930bff-9b51-4d0c-b2bd-c26a9e0f4600\" target=\"_blank\"><li> Cochrane South Africa Systematic Review Methods Webinar</li> </a>\r\n        </p>\r\n       \r\n    </div>\r\n<br />\r\n<br />\r\n</div>\r\n\r\n<div class=\"col-md-12 col-sm-12\" style=\"background-image: url('../images/AfricanFabric.png');\r\n    height: 41px\">\r\n</div>\r\n<div id=\"dvContact\" class=\"col-md-12 col-sm-12 ContactBox\">\r\n    <div class=\"page-headingB\">\r\n        Contact Us\r\n    </div>\r\n    <div class=\"col-md-12 col-sm-12 ContentSlab\">\r\n        <div id=\"MainContent_ucHome_pnlResearch\">\r\n\t\r\n            <div class=\"col-md-12 col-sm-12\">\r\n                <span class=\"page-subheading\">Send us a message</span>\r\n                <hr />\r\n            </div>\r\n            <div class=\"col-md-12 col-sm-12 form-group\">\r\n                <div class=\"col-md-6 col-sm-6\">\r\n                    <input name=\"ctl00$MainContent$ucHome$txtName\" type=\"text\" id=\"txtName\" class=\"form-control\" placeholder=\"Enter your name\" onkeypress=\"return CheckAlphaNumericWithSpaceDot(event);\" />\r\n                    \r\n                </div>\r\n                <div class=\"col-md-6 col-sm-6\">\r\n                    <input name=\"ctl00$MainContent$ucHome$txtEmail\" type=\"text\" id=\"txtEmail\" class=\"form-control\" placeholder=\"Enter your email\" onkeypress=\"return spaceRemover(event);\" onblur=\"this.value=this.value.toString().trim()\" />\r\n                    \r\n                    \r\n                </div>\r\n            </div>\r\n            <div class=\"col-md-12 col-sm-12 form-group\">\r\n                <div class=\"col-md-6 col-sm-6\">\r\n                    <select name=\"ctl00$MainContent$ucHome$ddlFeedbackType\" id=\"ddlFeedbackType\" class=\"form-control\" placeholder=\"Select type of feedback\">\r\n\t\t<option value=\"0\">-----Select Feedback Type-----</option>\r\n\t\t<option value=\"1\">Registration</option>\r\n\t\t<option value=\"2\">Login</option>\r\n\t\t<option value=\"3\">General</option>\r\n\r\n\t</select>\r\n                    \r\n                </div>\r\n                <div class=\"col-md-6 col-sm-6\">\r\n                </div>\r\n            </div>\r\n            <div class=\"col-md-12 col-sm-12 form-group\">\r\n                <div class=\"col-md-12 col-sm-12\">\r\n                    <textarea name=\"ctl00$MainContent$ucHome$txtFeedback\" rows=\"2\" cols=\"20\" id=\"txtFeedback\" class=\"form-control\" placeholder=\"Enter your feedback\">\r\n</textarea>\r\n                    \r\n                </div>\r\n            </div>\r\n            <div class=\"col-md-12 col-sm-12 form-group\">\r\n                <div class=\"col-md-4 col-sm-4\" style=\"padding-bottom: 15px\">\r\n                    <span style=\"color: #fff;\">I am not a robot </span>\r\n                    <img id=\"MainContent_ucHome_imgCaptcha\" src=\"Controls/Captcha.aspx\" height=\"55\" width=\"186\" />\r\n                    <a id=\"lbRefreshCaptcha\" href=\"javascript:__doPostBack(&#39;ctl00$MainContent$ucHome$lbRefreshCaptcha&#39;,&#39;&#39;)\"><span class=\"glyphicon glyphicon-refresh\"></span></a>\r\n                </div>\r\n                <div class=\"col-md-8 col-sm-8\">\r\n                    <input name=\"ctl00$MainContent$ucHome$txtVerificationCode\" type=\"text\" id=\"txtVerificationCode\" class=\"form-control\" placeholder=\"Enter Captcha\" />\r\n                    \r\n                </div>\r\n            </div>\r\n            <div class=\"col-md-12 col-sm-12 form-group\">\r\n                <div class=\"col-md-12 col-sm-12\">\r\n                    <input type=\"submit\" name=\"ctl00$MainContent$ucHome$btnSubmit\" value=\"Send now\" onclick=\"javascript:WebForm_DoPostBackWithOptions(new WebForm_PostBackOptions(&quot;ctl00$MainContent$ucHome$btnSubmit&quot;, &quot;&quot;, true, &quot;valFeedback&quot;, &quot;&quot;, false, false))\" id=\"MainContent_ucHome_btnSubmit\" class=
/font></a>\r\n                            <br />\r\n                            \r\n                            <input type=\"hidden\" name=\"TextBoxWatermarkExtender1_ClientState\" id=\"TextBoxWatermarkExtender1_ClientState\" value=\"Focused\" />\r\n\r\n\r\n                        </td>\r\n                    </tr>\r\n                    <tr>\r\n                        <td>\r\n                            <span><font face=\"Arial\" size=\"3\"><input id=\"chkCOVIDRestriction\" type=\"checkbox\" name=\"chkCOVIDRestriction\" /><label for=\"chkCOVIDRestriction\">Restrict to COVID-19</label></font></span>\r\n                        </td>\r\n                    </tr>\r\n                    <tr>\r\n                        <td>\r\n                            <span><font face=\"Arial\" size=\"3\"><input id=\"chkSearchClinical\" type=\"checkbox\" name=\"chkSearchClinical\" /><label for=\"chkSearchClinical\">Search for </label></font></span>\r\n                            <a id=\"HyperLink4\" href=\"https://www.who.int/clinical-trials-registry-platform/clinical-trials-in-children\" target=\"_blank\" style=\"display:inline-block;text-align: center\"><font face=\"Arial\" size=\"3\">clinical trials in children</font></a>\r\n                        </td>                        \r\n                    </tr>                    \r\n                    <tr style=\"height: 40px;\">\r\n                        <td>\r\n                            <span><font face=\"Arial\" size=\"3\"><input id=\"chkWithoutSynonyms\" type=\"checkbox\" name=\"chkWithoutSynonyms\" /><label for=\"chkWithoutSynonyms\">Without Synonyms</label></font></span>\r\n                        </td>\r\n                    </tr>\r\n                    <tr>\r\n                        <td>\r\n                            <a id=\"hyperlinkPhase\" title=\"Click for more information\" style=\"vertical-align: top\"><u><font face=\"Arial\" color=\"Blue\" size=\"3\">Phases</font></u></a>\r\n                            <span id=\"Label43\" style=\"vertical-align: top\"><font face=\"Arial\" size=\"3\">are   </font></span>\r\n\r\n                            <select size=\"4\" name=\"ListBoxPhase\" multiple=\"multiple\" id=\"ListBoxPhase\">\r\n\t<option value=\"All\">All</option>\r\n\t<option value=\"Phase 0\">Phase 0</option>\r\n\t<option value=\"Phase 1\">Phase 1</option>\r\n\t<option value=\"Phase 2\">Phase 2</option>\r\n\t<option value=\"Phase 3\">Phase 3</option>\r\n\t<option value=\"Phase 4\">Phase 4</option>\r\n\r\n</select>\r\n                        </td>\r\n                        <td>\r\n                            <div id=\"PanelPopUpPhase\" class=\"popupControl\">\r\n\t\r\n                                <div id=\"UpdatePanel13\">\r\n\t\t\r\n                                        <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"width: 100%;\">\r\n                                            <tr>\r\n                                                <td style=\"font-weight: bold; font-size: x-small; font-family: Arial\">Phases</td>\r\n                                            </tr>\r\n                                            <tr>\r\n                                                <td style=\"font-size: x-small; vertical-align: top; font-family: Arial;\">Hold down control key to select multiple phases.\r\n                                                </td>\r\n                                            </tr>\r\n                                        </table>\r\n                                    \r\n\t</div>\r\n                            \r\n</div>\r\n                            \r\n                        </td>\r\n                    </tr>\r\n                    <tr>\r\n                        <td>\r\n                            <span><font face=\"Arial\" size=\"3\"><input id=\"chkWithResultsOnly\" type=\"checkbox\" name=\"chkWithResultsOnly\" /><label for=\"chkWithResultsOnly\">With results only</label></font></span><br />\r\n                            <span><font face=\"Arial\" size=\"3\"><input id=\"chkRareDiseasesOnly\" type=\"checkbox\" name=\"chkRareDiseasesOnly\" /><label for=\"chkRareDiseasesOnly\">Rare diseases / orphan drugs</label></font></span>\r\n                        </td>\r\n                    </tr>\r\n                    <tr>\r\n                        <td>\r\n                            <span><font face=\"Arial\" size=\"3\"><input id=\"chkGeneEditing\" type=\"checkbox\" name=\"chkGeneEditing\" /><label for=\"chkGeneEditing\">Genome editing</label></font></span>\r\n                        </td>\r\n                    </tr>\r\n                    <tr>\r\n                        <td>\r\n                            <span id=\"Label19\" style=\"display:inline-block;\"><b><font face=\"Arial\" color=\"Red\" size=\"2\"></font></b></span></td>\r\n                    </tr>\r\n                </table>\r\n                <table>\r\n                    <tr>\r\n                        <td style=\"height: 21px; width: 45%;\">\r\n                            <span id=\"Label6\"><b><font face=\"Arial\" size=\"2\">Welcome</font></b></span></td>\r\n                        <td style=\"height: 21px; width: 55%;\">\r\n                            <span id=\"Label5\"><b><font face=\"Arial\" size=\"2\">Data Providers</font></b></span></td>\r\n\r\n                    </tr>\r\n                    <tr>\r\n                        <td bgcolor=\"gainsboro\" style=\"vertical-align: top;\">\r\n                            <ul style=\"font-family: Arial; font-size: 8pt;\">\r\n                                <li>The Clinical Trials Search Portal provides access to a central database containing the trial registration data sets provided by the registries listed on the right. It also provides links to the full original records.\r\n                                    <br>\r\n                                </li>\r\n                                <li>To facilitate the unique identification of trials, the Search Portal bridges (groups together) multiple records about the same trial. <a href='https://www.who.int/clinical-trials-registry-platform/the-ictrp-search-portal/linking-related-records-on-the-ictrp-search-portal' target='new'>More information</a><br>\r\n                                    <br>\r\n                                </li>\r\n                                <li>Please note: This Search Portal is not a clinical trials registry. <a href='https://www.who.int/clinical-trials-registry-platform/network/trial-registration' target='blank'>How to register a trial</a><br>\r\n                                    <br>\r\n                                </li>\r\n                                <li>It is possible to export the results of the search into XML.  <a href='https://www.who.int/clinical-trials-registry-platform/network/who-data-set/downloading-records-from-the-ictrp-database' target='blank'>More information</a><br>\r\n                                    <br>\r\n                                </li>\r\n                                <li>The Crawling service is currently not available. If you wish to use this service in 2025 or when it is made available please <a href='https://forms.gle/cJVp7X7kvyXLqoaB7' target=\"_blank\">fill this survey</a><br>\r\n                                    <br>\r\n                                </li>\r\n                            </ul>\r\n                            </ul>\r\n                        </td>\r\n                        <td bgcolor=\"gainsboro\" style=\"vertical-align: top; width: 425px;\">\r\n                            <!-- GD 2021-07-23 removed by Ghassan's request \r\n                                <span style=\"font-size: 8pt; font-family: Arial\">\r\n                                <span id=\"Label21\" style=\"display:inline-block;\"><font face=\"Arial\" size=\"1\">Data sets from <a href='http://www.who.int/ictrp/search/data_providers/en/index.html' target='blank'>data providers</a> are updated every Friday evening according to the following schedule:</font></span></span>\r\n                            <br />\r\n                            <span id=\"Label23\"><font face=\"Arial\" size=\"1\">Every week:</font></span>\r\n                                -->\r\n                            <ul>\r\n                                <span id=\"lblAustralia\" style=\"display:inline-block;\"><font face=\"Arial\" size=\"1\"><li>Australian New Zealand Clinical Trials Registry, last data file imported on <b>26 October 2026</b><br></font></span>\r\n                                <span id=\"lblChinese\" style=\"display:inline-block;\"><font face=\"Arial\" size=\"1\"><li>Chinese Clinical Trial Registry, last data file imported on <b>26 October 2026</b><br></font></span>\r\n                                <span id=\"lblClinical\" style=\"display:inline-block;\"><font face=\"Arial\" size=\"1\"><li>ClinicalTrials.gov, last data file imported on <b>26 October 2026</b><br></font></span>\r\n                                <span id=\"lblCtis\" style=\"display:inline-block;\"><font face=\"Arial\" size=\"1\"><li>Clinical Trials Information System (CTIS), last data file imported on <b>26 October 2026</b></font></span>\r\n                                <span id=\"lblEUClinical\" style=\"display:inline-block;\"><font face=\"Arial\" size=\"1\"><li>EU Clinical Trials Register (EU-CTR), last data file imported on <b>26 October 2026</b></font></span>\r\n                                <span id=\"lblISRCTN\" style=\"display:inline-block;\"><font face=\"Arial\" size=\"1\"><li>ISRCTN, last data file imported on <b>26 October 2026</b></font></span>\r\n                                <span id=\"lblNetherland\" style=\"display:inline-block;\"><font face=\"Arial\" size=\"1\"><li>The Netherlands National Trial Register, last data file imported on <b>26 October 2026</b></font></span>\r\n                            </ul>\r\n                            <!-- GD 2021-07-23 removed by Ghassan's request \r\n                            <span id=\"lblEvery4Weeks\"><font face=\"Arial\" size=\"1\">Every 4 weeks:</font></span>\r\n                                -->\r\n                            <ul><!-- GD 2023-02-23 changed width on first element to avoid wrapping -->\r\n                                <span id=\"lblBrazilian\" style=\"display:inline-block;\"><font face=\"Arial\" size=\"1\"><li>Brazilian Clinical Trials Registry (ReBec), last data file imported on <b>12 October 2026</b></font></span>\r\n                                <span id=\"lblIndia\" style=\"display:inline-block;\"><font face=\"Arial\" size=\"1\"><li>Clinical Trials Registry - India, last data file imported on <b>12 October 2026</b><br></font></span>\r\n                                <span id=\"lblKorea\" style=\"display:inline-block;\"><font face=\"Arial\" size=\"1\"><li>Clinical Research Information Service - Republic of Korea, last data file imported on <b>26 October 2026</b></font></span>\r\n                                <span id=\"lblCuba\" style=\"display:inline-block;\"><font face=\"Arial\" size=\"1\"><li>Cuban Public Registry of Clinical Trials, last data file imported on <b>12 October 2026</b></font></span>\r\n                                <span id=\"lblGerman\" style=\"display:inline-block;\"><font face=\"Arial\" size=\"1\"><li>German Clinical Trials Register, last data file imported on <b>12 October 2026</b></font></span>\r\n                                <span id=\"lblIran\" style=\"display:inline-block;\"><font face=\"Arial\" size=\"1\"><li>Iranian Registry of Clinical Trials, last data file imported on <b>1 June 2026</b></font></span>\r\n                                <span id=\"lblJapan\" style=\"display:inline-block;\"><font face=\"Arial\" size=\"1\"><li>Japan Registry of Clinical Trials (jRCT), last data file imported on <b>14 September 2026</b></font></span>\r\n                                <span id=\"lblPanafrica\" style=\"display:inline-block;\"><font face=\"Arial\" size=\"1\"><li>Pan African Clinical Trial Registry, last data file imported on <b>14 September 2026</b></font></span>\r\n                                <span id=\"lblSriLanka\" style=\"display:inline-block;\"><font face=\"Arial\" size=\"1\"><li>Sri Lanka Clinical Trials Registry, last data file imported on <b>12 October 2026</b></font></span>\r\n                                <span id=\"lblThai\" style=\"display:inline-block;\"><font face=\"Arial\" size=\"1\"><li>Thai Clinical Trials Registry (TCTR), last data file imported on <b>12 October 2026</b></font></span>\r\n                                <span id=\"lblPeru\" style=\"display:inline-block;\"><font face=\"Arial\" size=\"1\"><li>Peruvian Clinical Trials Registry (REPEC), last data file imported on <b>30 March 2026</b></font></span>\r\n                                <span id=\"lblLebanon\" style=\"display:inline-block;\"><font face=\"Arial\" size=\"1\"><li>Lebanese Clinical Trials Registry (LBCTR), last data file imported on <b>2 February 2026</b></font></span>\r\n                                <span id=\"lblTrad\" style=\"display:inline-block;\"><font face=\"Arial\" size=\"1\"><li>International Traditional Medicine Clinical Trial Registry (ITMCTR), last data file imported on <b>19 October 2026</b></font></span>\r\n                            </ul>\r\n\r\n                        </td>\r\n\r\n\r\n                    </tr>\r\n                </table>\r\n            \r\n\r\n        <table align=\"center\" width=\"100%\">\r\n            <tr>\r\n                <td style=\"border-top: #6ba2cc thick solid\">\r\n                    <span id=\"Label18\" style=\"display:inline-block;\"><b><font face=\"Arial\" size=\"2\">Disclaimer: Trials posted on this search portal are not endorsed by WHO, but are provided as a service to our users. In no event shall the World Health Organization be liable for any damages arising from the use of the information linked to in this section. None of the information obtained through use of the search portal should in any way be used in clinical care without consulting a physician or licensed health professional. WHO is not responsible for the accuracy, completeness and/or use made of the content displayed for any trial record.</font></b></span></td>\r\n            </tr>\r\n            <tr>\r\n\r\n                <td align=\"center\" style=\"height: 21px\">\r\n                    <a id=\"HyperLink8\" href=\"http://www.who.int/about/copyright/en/\" target=\"_blank\" style=\"text-align: center\"><b><font face=\"Arial\" size=\"2\">Copyright - World Health Organization</font></b></a>\r\n                    <span id=\"Label17\"><b><font face=\"Arial\" size=\"2\">- Version 3.6 -</font></b></span>\r\n                    <a id=\"HyperLink3\" href=\"ICTRP_Revisions_document.pdf\" target=\"_blank\" style=\"text-align: center\"><b><font face=\"Arial\" size=\"2\">Version history</font></b></a>&nbsp;<span id=\"Label32\"><b><font face=\"Arial\" size=\"2\">  </font></b></span>  \r\n                    &nbsp;<!-- \r\n                            <a id=\"HyperLink9\" href=\"crawl/crawl0.aspx\" target=\"_self\" style=\"text-align: center\"><font face=\"Arial\" size=\"2\">For crawlers</font></a> -->\r\n                        </td>\r\n\r\n            </tr>\r\n        </table>\r\n\r\n\r\n\r\n\r\n    \r\n\r\n<script type=\"text/javascript\">\r\n//<![CDATA[\r\n(function() {var fn = function() {$get(\"ToolkitScriptManager_HiddenField\").value = '';Sys.Application.remove_init(fn);};Sys.Application.add_init(fn);})();var Menu1_Data = new Object();\r\nMenu1_Data.disappearAfter = 500;\r\nMenu1_Data.horizontalOffset = 2;\r\nMenu1_Data.verticalOffset = 0;\r\nMenu1_Data.hoverClass = '';\r\nSys.Application.add_init(function() {\r\n    $create(Sys.Extended.UI.TextBoxWatermarkBehavior, {\"ClientStateFieldID\":\"TextBoxWatermarkExtender1_ClientState\",\"WatermarkCssClass\":\"watermark\",\"WatermarkText\":\"Example: liver cancer OR breast cancer NOT genetic\",\"id\":\"TextBoxWatermarkExtender1\"}, null, null, $get(\"TextBox1\"))
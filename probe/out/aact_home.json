 "text": "<!DOCTYPE html>\n<html class=\"scroll-smooth\">\n  <head>\n    <link rel=\"preload\" href=\"/assets/Figtree-7367b47d.woff2\" as=\"font\" type=\"font/woff2\" crossorigin>\n    <title>Aact</title>\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<meta name=\"mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n<meta name=\"csrf-param\" content=\"authenticity_token\" />\n<meta name=\"csrf-token\" content=\"lBJk3iAZZ2vgZmVFYNNQ58NY3RguZjFi5o7qiSgTOlFxOVfYhIQBb75VaQpTH9ejbY__p3bSbxy2jY-Sf7MCFw\" />\n\n<meta name=\"action-cable-url\" content=\"/cable\" />\n\n\n\n<link rel=\"manifest\" href=\"/manifest.json\">\n<link rel=\"icon\" href=\"/icon.png\" type=\"image/png\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"apple-touch-icon\" href=\"/icon.png\">\n<link rel=\"stylesheet\" href=\"/assets/tailwind-5e40f050.css\" data-turbo-track=\"reload\" />\n<script type=\"importmap\" data-turbo-track=\"reload\">{\n  \"imports\": {\n    \"application\": \"/assets/application-a9582491.js\",\n    \"@hotwired/turbo-rails\": \"/assets/turbo.min-e867e79e.js\",\n    \"@hotwired/stimulus\": \"/assets/stimulus.min-4b1e420e.js\",\n    \"@hotwired/stimulus-loading\": \"/assets/stimulus-loading-1fc53fe7.js\",\n    \"chartkick\": \"/assets/chartkick-fbe22225.js\",\n    \"Chart.bundle\": \"/assets/Chart.bundle-730782c8.js\",\n    \"controllers/application\": \"/assets/controllers/application-96ca67d3.js\",\n    \"controllers/clipboard_controller\": \"/assets/controllers/clipboard_controller-54a4a0ba.js\",\n    \"controllers/iframe_loader_controller\": \"/assets/controllers/iframe_loader_controller-b8a833af.js\",\n    \"controllers\": \"/assets/controllers/index-ee64e1f1.js\",\n    \"controllers/password_requirements_controller\": \"/assets/controllers/password_requirements_controller-e3ccd04a.js\",\n    \"controllers/reveal_controller\": \"/assets/controllers/reveal_controller-298e0ae8.js\",\n    \"controllers/scroll_to_active_controller\": \"/assets/controllers/scroll_to_active_controller-6bcebc64.js\",\n    \"controllers/scroll_to_hash_controller\": \"/assets/controllers/scroll_to_hash_controller-63e60846.js\",\n    \"controllers/scrollspy_controller\": \"/assets/controllers/scrollspy_controller-d365a645.js\",\n    \"controllers/snapshot_compare_controller\": \"/assets/controllers/snapshot_compare_controller-984d4e5d.js\",\n    \"controllers/sync_controller\": \"/assets/controllers/sync_controller-7dd97b85.js\"\n  }\n}</script>\n<link rel=\"modulepreload\" href=\"/assets/application-a9582491.js\">\n<link rel=\"modulepreload\" href=\"/assets/turbo.min-e867e79e.js\">\n<link rel=\"modulepreload\" href=\"/assets/stimulus.min-4b1e420e.js\">\n<link rel=\"modulepreload\" href=\"/assets/stimulus-loading-1fc53fe7.js\">\n<link rel=\"modulepreload\" href=\"/assets/chartkick-fbe22225.js\">\n<link rel=\"modulepreload\" href=\"/assets/Chart.bundle-730782c8.js\">\n<link rel=\"modulepreload\" href=\"/assets/controllers/application-96ca67d3.js\">\n<link rel=\"modulepreload\" href=\"/assets/controllers/clipboard_controller-54a4a0ba.js\">\n<link rel=\"modulepreload\" href=\"/assets/controllers/iframe_loader_controller-b8a833af.js\">\n<link rel=\"modulepreload\" href=\"/assets/controllers/index-ee64e1f1.js\">\n<link rel=\"modulepreload\" href=\"/assets/controllers/password_requirements_controller-e3ccd04a.js\">\n<link rel=\"modulepreload\" href=\"/assets/controllers/reveal_controller-298e0ae8.js\">\n<link rel=\"modulepreload\" href=\"/assets/controllers/scroll_to_active_controller-6bcebc64.js\">\n<link rel=\"modulepreload\" href=\"/assets/controllers/scroll_to_hash_controller-63e60846.js\">\n<link rel=\"modulepreload\" href=\"/assets/controllers/scrollspy_controller-d365a645.js\">\n<link rel=\"modulepreload\" href=\"/assets/controllers/snapshot_compare_controller-984d4e5d.js\">\n<link rel=\"modulepreload\" href=\"/assets/controllers/sync_controller-7dd97b85.js\">\n<script type=\"module\">import \"application\"</script>\n<meta name=\"sentry-trace\" content=\"7e9c1528ff474317be1898bc45a7adf1-66ee6fadf50d4a5e-0\">\n<meta name=\"baggage\" content=\"sentry-trace_id=7e9c1528ff474317be1898bc45a7adf1,sentry-sample_rate=0.1,sentry-sample_rand=0.650865,sentry-sampled=false,sentry-environment=production,sentry-public_key=d283a3d5489034d304750ccd4e3d5f83,sentry-org_id=4511009972682752\">\n\n  </head>\n\n  <body class=\"min-h-screen flex flex-col bg-white text-ink font-display\">\n    <!-- Marketing header -->\n    <header class=\"border-b border-line\">\n      <div class=\"mx-auto max-w-6xl px-8\">\n        <div class=\"flex items-center justify-between h-16\">\n          <a class=\"flex items-center gap-3\" href=\"/landing\">\n            <img alt=\"\" aria-hidden=\"true\" class=\"h-9 w-auto\" src=\"/assets/aact-logo-bc97cd2b.svg\" />\n            <span class=\"flex flex-col leading-tight\">\n              <span class=\"text-xl font-bold text-primary-dark\">AACT</span>\n              <span class=\"hidden sm:block font-mono text-[10px] uppercase tracking-widest text-ink-muted\">\n                Aggregate Analysis of ClinicalTrials.gov\n              </span>\n            </span>\n</a>          <nav class=\"flex items-center gap-4\">\n            <a class=\"text-sm text-link font-medium hover:text-primary-dark\" href=\"/session/new\">Sign in</a>\n            <a class=\"px-4 py-2 rounded-sm bg-link text-white text-[12px] font-[300] uppercase tracking-widest hover:bg-primary-dark transition-colors\" href=\"/sign_up\">Create account</a>\n          </nav>\n        </div>\n      </div>\n    </header>\n\n    <turbo-frame id=\"flash_messages\"></turbo-frame>\n\n    <main class=\"flex-1\">\n      <section class=\"relative overflow-hidden bg-primary-dark bg-linear-to-br from-primary-dark via-primary to-link text-white\">\n  <div class=\"relative mx-auto max-w-6xl px-8 pt-32 pb-40\">\n    <div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0\">\n      <div class=\"absolute right-[70px] top-[150px] h-[250px] w-[250px] rotate-45 border border-white/[0.14]\"></div>\n      <div class=\"absolute right-[120px] top-[70px] h-[170px] w-[170px] rotate-45 border border-white/[0.18]\"></div>\n      <div class=\"absolute right-[150px] top-[120px] h-[9px] w-[9px] rotate-45 bg-[#E1607B]/80\"></div>\n      <div class=\"absolute right-[210px] top-[260px] h-3 w-3 rotate-45 bg-[#7FB2E6]/70\"></div>\n      <div class=\"absolute right-[300px] top-[200px] h-2 w-2 rotate-45 bg-white/50\"></div>\n      <div class=\"absolute bottom-24 right-8 flex h-[120px] items-end gap-[9px]\">\n        <div class=\"w-4 rounded-[3px] bg-[#7FB2E6]/40\" style=\"height:44px\"></div>\n        <div class=\"w-4 rounded-[3px] bg-[#7FB2E6]/55\" style=\"height:72px\"></div>\n        <div class=\"w-4 rounded-[3px] bg-white/60\" style=\"height:100px\"></div>\n        <div class=\"w-4 rounded-[3px] bg-[#7FB2E6]/55\" style=\"height:58px\"></div>\n        <div class=\"w-4 rounded-[3px] bg-[#E1607B]/75\" style=\"height:120px\"></div>\n      </div>\n    </div>\n    <div class=\"relative max-w-3xl\">\n      <p class=\"mb-4 text-[12px] font-normal uppercase tracking-[0.3em] text-white/60\">\n        A CTTI public database · Updated daily\n      </p>\n      <h1 class=\"text-[46px] font-normal tracking-wide leading-tight\">\n        The entire ClinicalTrials.gov registry, in one analyzable database.\n      </h1>\n      <p class=\"mt-6 text-lg text-white/80 max-w-2xl tracking-wide leading-relaxed\">\n        AACT is a public relational database with all protocol and results data for every\n        study on ClinicalTrials.gov — refreshed daily, and ready to query in the cloud or download in full.\n      </p>\n      <div class=\"mt-8 flex flex-wrap gap-3\">\n        <a class=\"px-5 py-3 rounded-sm border bg-white text-primary text-sm font-medium uppercase tracking-widest hover:bg-surface-alt transition-colors\" href=\"/sign_up\">Create account</a>\n        <a class=\"px-5 py-3 rounded-sm border border-white/40 text-white text-sm font-medium uppercase tracking-widest hover:bg-white/10 transition-colors\" href=\"#how-it-works\">See how it works</a>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"mx-auto max-w-6xl px-8 pb-16 -mt-16 relative z-10\">\n  <div class=\"grid grid-cols-4 divide-x divide-line border border-line bg-white shadow-lg shadow-black/5\">\n    <div class=\"p-6\">\n      <p class=\"text-xs font-semibold uppercase tracking-widest text-primary\">Complete</p>\n      <p class=\"mt-3 text-sm text-ink-muted leading-relaxed\">All protocol and results data for every registered study.</p>\n    </div>\n    <div class=\"p-6\">\n      <p class=\"text-xs font-semibold uppercase tracking-widest text-primary\">Current</p>\n      <p class=\"mt-3 text-sm text-ink-muted leading-relaxed\">Refreshed daily, straight from the source registry.</p>\n    </div>\n    <div class=\"p-6\">\n      <p class=\"text-xs font-semibold uppercase tracking-widest text-primary\">Open</p>\n      <p class=\"mt-3 text-sm text-ink-muted leading-relaxed\">Query in the cloud or download the full database. No proprietary software.</p>\n    </div>\n    <div class=\"p-6\">\n      <p class=\"text-xs font-semibold uppercase tracking-widest text-primary\">Credible</p>\n      <p class=\"mt-3 text-sm text-ink-muted leading-relaxed\">Built and maintained by CTTI, co-founded by Duke University and the FDA.</p>\n    </div>\n  </div>\n</section>\n\n<section class=\"mx-auto max-w-6xl px-8 py-20\">\n  <div class=\"grid grid-cols-2 gap-16 items-center\">\n    <div>\n      <p class=\"mb-4 font-mono text-sm uppercase tracking-widest text-accent\">What is AACT</p>\n      <h2 class=\"text-3xl font-normal tracking-wide text-primary-dark\">Built for broad analysis.</h2>\n      <p class=\"mt-6 text-lg text-ink-muted leading-relaxed\">\n        ClinicalTrials.gov is a website and registry hosted by the National Library of\n        Medicine (NLM) at the National Institutes of Health (NIH) in collaboration with\n        the U.S. Food and Drug Administration (FDA). It is primarily used for\n        looking up a single study or studies for potential enrollment by patients,\n        caregivers, and/or healthcare providers but was not designed for analysis across\n        many studies.\n      </p>\n      <p class=\"mt-6 text-lg text-ink-muted leading-relaxed\">\n        AACT downloads the full ClinicalTrials.gov registry every\n        day and reorganizes it into a relational database of 40+ connected tables\n        covering conditions, interventions, sponsors, eligibility, outcomes, adverse\n        events, and results, enabling you to explore and analyze the clinical research\n        landscape.\n      </p>\n    </div>\n\n    <div class=\"rounded-sm border border-line bg-surface-alt p-8\">\n      <p class=\"mb-12 font-mono text-xs uppercase tracking-widest text-ink-muted/80\">One study → many connected tables</p>\n      <div class=\"mb-10 flex items-start justify-between gap-3\">\n        <span class=\"rounded-sm border border-line bg-white px-4 py-2 font-mono text-xs text-link\">conditions</span>\n        <span class=\"-mt-6 rounded-sm border border-line bg-white px-4 py-2 font-mono text-xs text-link\">eligibility</span>\n        <span class=\"rounded-sm border border-line bg-white px-4 py-2 font-mono text-xs text-link\">interventions</span>\n      </div>\n      <div class=\"mb-10 flex justify-center\">\n        <span class=\"rounded-sm bg-primary-dark px-5 py-2.5 font-mono text-xs text-white\">studies</span>\n      </div>\n      <div class=\"flex items-start justify-between gap-3\">\n        <span class=\"rounded-sm border border-line bg-white px-4 py-2 font-mono text-xs text-link\">outcomes</span>\n        <span class=\"mt-6 rounded-sm border border-line bg-white px-4 py-2 font-mono text-xs text-link\">adverse_events</span>\n        <span class=\"rounded-sm border border-line bg-white px-4 py-2 font-mono text-xs text-link\">sponsors</span>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"bg-surface-alt\">\n  <div class=\"mx-auto max-w-6xl px-8 py-20\">\n    <p class=\"mb-4 font-mono text-sm uppercase tracking-widest text-accent\">Access</p>\n    <h2 class=\"text-3xl font-normal tracking-wide text-primary-dark\">Set up access in about two minutes.</h2>\n    <p class=\"mt-6 max-w-2xl text-lg text-ink-muted leading-relaxed\">\n      Create an account to connect to the cloud database with your own credentials, download full\n      snapshots, and keep up with what's new.\n    </p>\n\n    <div class=\"mt-6 grid grid-cols-4 gap-4\">\n      <div class=\"rounded-sm border border-line bg-white p-6\">\n        <h3 class=\"text-lg text-primary-dark\">Live cloud access</h3>\n        <p class=\"mt-2 text-sm text-ink-muted leading-relaxed\">Query with SQL from psql, pgAdmin, R, or Python.</p>\n      </div>\n      <div class=\"rounded-sm border border-line bg-white p-6\">\n        <h3 class=\"text-lg text-primary-dark\">Historical snapshots</h3>\n        <p class=\"mt-2 text-sm text-ink-muted leading-relaxed\">Download the latest database or past versions to compare.</p>\n      </div>\n      <div class=\"rounded-sm border border-line bg-white p-6\">\n        <h3 class=\"text-lg text-primary-dark\">Schema &amp; data dictionary</h3>\n        <p class=\"mt-2 text-sm text-ink-muted leading-relaxed\">Find the right tables and fields fast.</p>\n      </div>\n      <div class=\"rounded-sm border border-line bg-white p-6\">\n        <h3 class=\"text-lg text-primary-dark\">Update notifications</h3>\n        <p class=\"mt-2 text-sm text-ink-muted leading-relaxed\">Know when the data or schema changes.</p>\n      </div>\n    </div>\n\n    <a class=\"mt-10 inline-block rounded-sm bg-link px-6 py-3 text-sm uppercase tracking-widest text-white hover:bg-primary-dark transition-colors\" href=\"/sign_up\">Create your account</a>\n  </div>\n</section>\n\n<section id=\"how-it-works\" class=\"mx-auto max-w-6xl px-8 py-20\">\n  <p class=\"mb-4 font-mono text-sm uppercase tracking-widest text-accent\">Get started</p>\n  <h2 class=\"text-3xl font-normal tracking-wide text-primary-dark\">Three steps from question to analysis.</h2>\n\n  <div class=\"mt-12 grid grid-cols-3 divide-x divide-line border border-line\">\n    <div class=\"p-8\">\n      <p class=\"font-mono text-sm text-accent\">01</p>\n      <h3 class=\"mt-4 text-xl text-primary-dark\">Create an account</h3>\n      <p class=\"mt-3 text-sm text-ink-muted leading-relaxed\">Sign up in about two minutes to get your database credentials.</p>\n    </div>\n    <div class=\"p-8\">\n      <p class=\"font-mono text-sm text-accent\">02</p>\n      <h3 class=\"mt-4 text-xl text-primary-dark\">Connect or download</h3>\n      <p class=\"mt-3 text-sm text-ink-muted leading-relaxed\">Query the cloud database with SQL, or download a full snapshot to run locally.</p>\n    </div>\n    <div class=\"p-8\">\n      <p class=\"font-mono text-sm text-accent\">03</p>\n      <h3 class=\"mt-4 text-xl text-primary-dark\">Explore the schema</h3>\n      <p class=\"mt-3 text-sm text-ink-muted leading-relaxed\">Use the data dictionary and schema diagram to find the tables you need.</p>\n    </div>\n  </div>\n</section>\n\n<section class=\"mx-auto max-w-6xl px-8 py-20\">\n  <div class=\"rounded-sm border border-line bg-surface-alt p-10\">\n    <p class=\"mb-8 font-mono text-sm uppercase tracking-widest text-link\">A CTTI resource</p>\n\n    <div class=\"flex items-center gap-10\">\n      <div class=\"flex shrink-0 flex-col items-center justify-center self-stretch border-r border-gray-300 pr-10\">\n        <img alt=\"CTTI logo\" class=\"h-24 w-auto\" src=\"/assets/ctti-logo-9a227355.svg\" />\n      </div>\n\n      <div class=\"min-w-0 flex-1\">\n        <p class=\"text-xl text-primary-dark leading-relaxed\">\n          AACT is a project of the <strong class=\"font-semibold\">Clinical Trials Transformation Initiative (CTTI)</strong>,\n          a public-private partnership co-founded by Duke University and the U.S. FDA to improve the quality and\n          efficiency of clinical trials.\n        </p>\n        <a target=\"_blank\" rel=\"noopener\" class=\"mt-6 inline-block text-base font-medium aact-link\" href=\"https://ctti-clinicaltrials.org\">Visit ctti-clinicaltrials.org</a>\n      </div>\n\n      <div class=\"flex shrink-0 flex-col items-center justify-center self-stretch border-l border-gray-300 pl-10 text-center\">\n        <p class=\"text-xs uppercase tracking-widest text-ink-muted\">Since</p>\n        <p class=\"text-5xl font-medium leading-none text-primary-dark\">2012</p>\n        <p class=\"mt-2 text-xs leading-snug text-ink-muted\">maintained &amp;<br>refreshed daily</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"mx-auto max-w-6xl px-8 py-20\">\n  <div class=\"relative overflow-hidden rounded-sm bg-primary-dark bg-linear-to-br from-primary-dark via-primary to-link px-8 py-20 text-center text-white\">\n    <div aria-hidden=\"true\" class=\"pointer-events-none absolute inset-0\">\n      <div class=\"absolute -bottom-[50px] -left-[30px] h-[160px] w-[160px] rotate-45 border border-white/10\"></div>\n      <div class=\"absolute -top-[40px] -right-[40px] h-[200px] w-[200px] rotate-45 border border-white/10\"></div>\n    </div>\n    <div class=\"relative\">\n      <h2 class=\"text-4xl font-normal tracking-wide\">Ready to query the whole registry?</h2>\n      <p class=\"mt-4 text-lg text-white/70\">Create an account and connect in minutes.</p>\n      <a class=\"mt-8 inline-block rounded-sm bg-white px-6 py-3 text-sm font-medium uppercase tracking-widest text-primary hover:bg-surface-alt transition-colors\" href=\"/sign_up\">Get started</a>\n    </div>\n  </div>\n</section>\n\n    </main>\n\n    <!-- Marketing footer -->\n    <footer class=\"border-t border-line mt-12\">\n      <div class=\"mx-auto max-w-6xl px-8 py-6 flex flex-wrap items-center justify-between gap-4 text-sm text-ink-muted\">\n        <p>\n          &copy; 2026 Clinical Trials Transformation Initiative ·\n          A project of <a target=\"_blank\" rel=\"noopener\" class=\"font-medium text-ink hover:text-link\" href=\"https://ctti-clinicaltrials.org\">CTTI</a>.\n          Data derived from <a target=\"_blank\" rel=\"noopener\" class=\"font-medium text-ink hover:text-link\" href=\"https://clinicaltrials.gov\">ClinicalTrials.gov</a>.\n        </p>\n      </div>\n    </footer>\n  </body>\n</html>\n"
}